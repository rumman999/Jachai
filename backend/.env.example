# Copy the ones you need into your Railway/Render service variables.

# true = Day 1 behaviour: fixed job id, alternating red/green, no inference
MOCK_MODE=false
# false = heuristic scorer only (low-memory hosts)
ENABLE_ML=true
MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model
# Set only if /health shows model labels that the auto-detection maps wrongly
FAKE_LABEL=
FAKE_THRESHOLD=0.5
VIDEO_FRAMES=6
JOB_TIMEOUT_S=8
OCR_LANGS=ben+eng
# Windows only, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
HOAX_THRESHOLD=0.58
ENABLE_EMBEDDINGS=false
MAX_UPLOAD_MB=50
